<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#0F1419">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_launcher_foreground"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MediaDownloader"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pega un enlace de X/Twitter o Instagram"
        android:textSize="14sp"
        android:textColor="#8B98A5"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://x.com/..."
        android:textColorHint="#536471"
        android:textColor="#FFFFFF"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:inputType="textUri"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descargar Vídeo"
        android:backgroundTint="#1D9BF0"
        android:textColor="#FFFFFF"
        android:padding="12dp"/>

</LinearLayout>
